<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>04100204</id>
        <display_name>DRM Based ROM</display_name>
        <version>1.9</version>
        <instance>isp_tone_lut_2048x8</instance>
        <family>Logos2</family>
        <device>PG2L100H</device>
        <package>FBG676</package>
        <speedgrade>-6</speedgrade>
        <generator version="2025.2" build="211867">IP Compiler</generator>
    </header>
    <param_list>
        <param>
            <name>ADDR_STROBE_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>ADDR_WIDTH</name>
            <type>int</type>
            <value>11</value>
        </param>
        <param>
            <name>CAS_MODE</name>
            <type>enum</type>
            <value>18K</value>
        </param>
        <param>
            <name>CAS_MODE_SEL</name>
            <type>enum</type>
            <value>DRM18K</value>
        </param>
        <param>
            <name>CLK_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>CLK_OR_POL_INV</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>DATA_WIDTH</name>
            <type>int</type>
            <value>8</value>
        </param>
        <param>
            <name>FAB_REG</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>INIT_EN</name>
            <type>bool</type>
            <value>true</value>
        </param>
        <param>
            <name>INIT_FILE</name>
            <type>string</type>
            <value>D:/QiansaiFPGA/final_exam/PG2L100H_improve/build/v025_isp_natural_tone/PG2L100H_final/assets/isp/tone_profiles.dat</value>
        </param>
        <param>
            <name>INIT_FORMAT</name>
            <type>enum</type>
            <value>HEX</value>
        </param>
        <param>
            <name>OUTPUT_REG</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>POWER_OPT</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>RD_OCE_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
        <param>
            <name>RESET_TYPE</name>
            <type>enum</type>
            <value>ASYNC</value>
        </param>
        <param>
            <name>RST_VAL</name>
            <type>string</type>
            <value>0</value>
        </param>
        <param>
            <name>RST_VAL_EN</name>
            <type>bool</type>
            <value>false</value>
        </param>
    </param_list>
    <pin_list>
        <pin>
            <name>addr</name>
            <text>addr</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>10</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>clk</name>
            <text>clk</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>rst</name>
            <text>rst</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>rd_data</name>
            <text>rd_data</text>
            <dir>output</dir>
            <pos>right</pos>
            <msb>7</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>clk_en</name>
            <text>clk_en</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>addr_strobe</name>
            <text>addr_strobe</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>rd_oce</name>
            <text>rd_oce</text>
            <visible>0</visible>
            <dir>input</dir>
            <pos>right</pos>
        </pin>
    </pin_list>
    <synthesis>
        <script><![CDATA[set_option -vlog_std v2001]]></script>
        <script><![CDATA[set_option -disable_io_insertion 1]]></script>
    </synthesis>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="isp_tone_lut_2048x8_tb.v" format="verilog" description="Compiled File"/>
            <file pathname="isp_tone_lut_2048x8_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="isp_tone_lut_2048x8_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="rtl/ipm2l_rom_v1_9_isp_tone_lut_2048x8.v"/>
            <file pathname="rtl/ipm2l_spram_v1_9_isp_tone_lut_2048x8.v"/>
            <file pathname="isp_tone_lut_2048x8.v"/>
        </source>
    </file_list>
</ip_inst>
