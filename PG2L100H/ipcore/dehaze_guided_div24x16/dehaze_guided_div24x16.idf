<?xml version="1.0" encoding="UTF-8"?>
<ip_inst>
    <header>
        <vendor>Pango</vendor>
        <id>052016</id>
        <display_name>Divider</display_name>
        <name>Logos2/Titan2/Kosmo2 Divider</name>
        <version>1.1</version>
        <instance>dehaze_guided_div24x16</instance>
        <family>Logos2</family>
        <device>PG2L100H</device>
        <package>FBG676</package>
        <speedgrade>-6</speedgrade>
        <generator version="2022.2-SP6.4" build="146967">IP Compiler</generator>
    </header>
    <param_list>
        <param>
            <name>ZERO_DETECT</name>
            <value>true</value>
        </param>
        <param>
            <name>DIVISOR_TREADY</name>
            <value>false</value>
        </param>
        <param>
            <name>Algorithm_Type</name>
            <value>1</value>
        </param>
        <param>
            <name>ACLKEN</name>
            <value>false</value>
        </param>
        <param>
            <name>TUSER</name>
            <value>true</value>
        </param>
        <param>
            <name>DIVISOR_TUSER</name>
            <value>false</value>
        </param>
        <param>
            <name>SIGNED</name>
            <value>0</value>
        </param>
        <param>
            <name>DIVISOR_WIDTH</name>
            <value>16</value>
        </param>
        <param>
            <name>ARESETN</name>
            <value>false</value>
        </param>
        <param>
            <name>DIVIDEND_TUSER</name>
            <value>false</value>
        </param>
        <param>
            <name>Optimize_Goal</name>
            <value>Performance</value>
        </param>
        <param>
            <name>DIVIDEND_TLAST</name>
            <value>false</value>
        </param>
        <param>
            <name>DIVIDEND_WIDTH</name>
            <value>24</value>
        </param>
        <param>
            <name>DIVIDEND_TUSER_Width</name>
            <value>1</value>
        </param>
        <param>
            <name>RoF_Width</name>
            <value>16</value>
        </param>
        <param>
            <name>BLOCKING</name>
            <value>Non Blocking</value>
        </param>
        <param>
            <name>TLAST</name>
            <value>false</value>
        </param>
        <param>
            <name>DIVISOR_TLAST</name>
            <value>false</value>
        </param>
        <param>
            <name>LATENCY</name>
            <value>26</value>
        </param>
        <param>
            <name>OUTPUT_TLAST</name>
            <item>NULL</item>
            <value>NULL</value>
        </param>
        <param>
            <name>Latency_Configuration</name>
            <value>Automatic</value>
        </param>
        <param>
            <name>DIVIDEND_TREADY</name>
            <value>false</value>
        </param>
        <param>
            <name>CLK_PER_DIVISION</name>
            <item>1</item>
            <item>2</item>
            <item>4</item>
            <item>8</item>
            <value>1</value>
        </param>
        <param>
            <name>Remainder_Type</name>
            <item>Fractional</item>
            <item>Remainder</item>
            <value>Remainder</value>
        </param>
        <param>
            <name>OUTPUT_TREADY</name>
            <value>false</value>
        </param>
        <param>
            <name>DIVISOR_TUSER_Width</name>
            <value>1</value>
        </param>
    </param_list>
    <pin_list>
        <pin>
            <name>i_aclk</name>
            <text>i_aclk</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>i_axi4s_dividend_tdata</name>
            <text>i_axi4s_dividend_tdata</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>23</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>i_axi4s_dividend_tvalid</name>
            <text>i_axi4s_dividend_tvalid</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>i_axi4s_divisor_tdata</name>
            <text>i_axi4s_divisor_tdata</text>
            <dir>input</dir>
            <pos>left</pos>
            <msb>15</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>i_axi4s_divisor_tvalid</name>
            <text>i_axi4s_divisor_tvalid</text>
            <dir>input</dir>
            <pos>left</pos>
        </pin>
        <pin>
            <name>o_axi4s_dout_tvalid</name>
            <text>o_axi4s_dout_tvalid</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
        <pin>
            <name>o_axi4s_dout_tdata</name>
            <text>o_axi4s_dout_tdata</text>
            <dir>output</dir>
            <pos>right</pos>
            <msb>39</msb>
            <lsb>0</lsb>
        </pin>
        <pin>
            <name>o_axi4s_dout_tuser</name>
            <text>o_axi4s_dout_tuser</text>
            <dir>output</dir>
            <pos>right</pos>
        </pin>
    </pin_list>
    <file_list>
        <output>
            <file pathname="generate.log" format="log" description="Generate Log"/>
            <file pathname="example_design/bench/ipsxe_divider_onboard_top_tb.v" format="verilog" description="Compiled File"/>
            <file pathname="example_design/rtl/ipsxe_divider_onboard_top.v" format="verilog" description="Compiled File"/>
            <file pathname="sim/modelsim/ipsxe_divider_onboard_top_filelist.f" format="verilog" description="Compiled File"/>
            <file pathname="pnr/core_only/ipsxe_divider_core_only.v" format="verilog" description="Compiled File"/>
            <file pathname="dehaze_guided_div24x16_tmpl.v" format="verilog" description="Instantiation Template"/>
            <file pathname="dehaze_guided_div24x16_tmpl.vhdl" format="vhdl" description="Instantiation Template"/>
        </output>
        <source>
            <file pathname="dehaze_guided_div24x16.v"/>
            <file pathname="rtl/synplify/ipsxe_divider_core_v1_1_vpAll.vp"/>
            <file pathname="rtl/fifo/ipsxe_divider_distributed_sdpram_v1_2.v"/>
        </source>
    </file_list>
</ip_inst>
