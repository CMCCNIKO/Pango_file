# PG2L100H-6 / FBG676 Ethernet + HDMI interface constraints
# 依据：PG2L100H 教程1硬件手册印刷页33（RTL8211F）和页44（MS7210）。
# RGMII RX external timing remains uncharacterized. TX uses explicit RTL8211F
# internal delay configuration and the nominal source-synchronous model below.

create_clock -name {sys_clk} [get_ports {i_sys_clk}] -period {37.037} -waveform {0.000 18.519}
create_clock -name {rgmii_rxc} [get_ports {i_rgmii_rxc}] -period {8.000} -waveform {0.000 4.000}
create_clock -name {hsst_refck1} [get_ports {i_p_refckp_1}] -period {8.000} -waveform {0.000 4.000}
# 3.125 Gb/s, 8B10B and a 32-bit RX fabric produce 78.125 MHz.
create_clock -name {fiber_rx_clk} [get_pins {u_video_sources_top/u_fiber_hsst_rx_adapter/u_fiber_hsst_ch0/o_p_clk2core_rx_2}] -period {12.800} -waveform {0.000 6.400}
# 2026-09-16 Windows reports HDMI-IN active signal 1920x1080@60 Hz; the
# unmodified 2_10_hdmi_loop MS7200 table is identical to this project and is
# the 1080p loop configuration. Camera onboard crystal is 24 MHz and OV5640
# TARGET/current PLL registers select nominal 84 MHz.
# Rounded down periods conservatively constrain internal PCLK-domain paths.
# External input delays remain uncharacterized; see Q8_PCLK_DEMO_AUDIT.
create_clock -name {hdmi_rx_pclk} [get_ports {i_hdmi_rx_pclk}] -period {6.734} -waveform {0.000 3.367}
create_clock -name {cmos1_pclk} [get_ports {i_cmos1_pclk}] -period {11.904} -waveform {0.000 5.952}
# hdmi_720p_pll is the official GPLL instance: 27 MHz x 11 / 4 = 74.25 MHz.
create_generated_clock -name {hdmi_pixel_clk} -source [get_ports {i_sys_clk}] [get_pins {u_hdmi_board_top/u_hdmi_720p_pll/clkout0}] -master_clock [get_clocks {sys_clk}] -multiply_by {11} -divide_by {4}
# HDMI forwarded clock and explicit package-interface engineering targets.
# The known-good PG2L_FINAL package envelope has next-edge setup >=7.440ns
# and same-edge hold >=0.476ns across reported slow/fast corners. The new
# target reserves setup >=2.000ns and hold >=0.500ns instead of leaving all
# 27 RGB/control pins unconstrained. These are implementation targets based
# on the known-good board interface, not a claimed MS7210 datasheet limit.
# PCB skew and the receiver electrical limits still require board validation.
create_generated_clock -name {hdmi_tx_pclk} -source [get_pins {u_hdmi_board_top/u_hdmi_tx_pclk_oddr/CLK}] [get_ports {o_hdmi_pclk}] -master_clock [get_clocks {hdmi_pixel_clk}] -divide_by {1}
set_output_delay -clock [get_clocks {hdmi_tx_pclk}] -max {2.000} [get_ports {o_hdmi_rgb[*] o_hdmi_vs o_hdmi_hs o_hdmi_de}]
set_output_delay -clock [get_clocks {hdmi_tx_pclk}] -min {-0.500} [get_ports {o_hdmi_rgb[*] o_hdmi_vs o_hdmi_hs o_hdmi_de}]

# RTL8211F TX internal-delay mode (MDIO D08/11 bit8, verified by readback).
# The physical TXC is forwarded at 0 degrees. This clock models the PHY's
# nominal 2ns internal sampling delay, NOT another physical FPGA phase shift.
# Realtek Rev1.1 sec10.6.2 Fig27/Table58: integrated receiver setup/hold >=1ns;
# a 1.5ns package engineering target additionally limits nominal TX skew to
# +/-0.5ns at 125MHz, leaving 0.5ns over those receiver minima. PCB mismatch
# and the PHY's unlisted internal-delay PVT range are not measured here.
# Both DDR sampling edges must be retained in the final timing report.
create_generated_clock -name {rgmii_phy_tx_sample} -source [get_pins {ethernet_top_Inst_network/u_rgmii_io/u_rgmii_txc_oddr/CLK}] [get_ports {o_rgmii_txc}] -master_clock [get_clocks {rgmii_rxc}] -edges {1 2 3} -edge_shift {2.000 2.000 2.000}
set_output_delay -clock [get_clocks {rgmii_phy_tx_sample}] -max {1.500} [get_ports {o_rgmii_txd[*] o_rgmii_tx_ctl}]
set_output_delay -clock [get_clocks {rgmii_phy_tx_sample}] -min {-1.500} [get_ports {o_rgmii_txd[*] o_rgmii_tx_ctl}]
set_output_delay -clock [get_clocks {rgmii_phy_tx_sample}] -clock_fall -add_delay -max {1.500} [get_ports {o_rgmii_txd[*] o_rgmii_tx_ctl}]
set_output_delay -clock [get_clocks {rgmii_phy_tx_sample}] -clock_fall -add_delay -min {-1.500} [get_ports {o_rgmii_txd[*] o_rgmii_tx_ctl}]

# U15 user QSPI Flash (Flash LUT reader).  SCK is a dedicated configuration
# clock driven by GTP_CFGCLK and therefore has no PAP_IO_LOC here.  The
# secondary U9 CS (F25) remains unconnected/high and is intentionally unused.
define_attribute {p:o_flash_cs_n} {PAP_IO_DIRECTION} {Output}
define_attribute {p:o_flash_cs_n} {PAP_IO_LOC} {P18}
define_attribute {p:o_flash_cs_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:o_flash_cs_n} {PAP_IO_STANDARD} {LVCMOS33}
