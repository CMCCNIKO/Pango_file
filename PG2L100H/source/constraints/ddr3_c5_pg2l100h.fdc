# PG2L100H C5 DDR3 video-path constraints.
# Q8: preserve existing LOC/electrical assignments; additional CDC objects below
# refer to the default unified path. External CMOS timing remains HW-PENDING.
# DDR clocks, generated-clock objects, placement and pins come from the
# current ddr3_hmic_s instance generated by PDS IP Compiler on 2026-09-10.

create_clock -name {ref_clk} [get_ports {ref_clk_p}] -period {8.000} -waveform {0.000 4.000}

create_generated_clock -name {rst_clk} -source [get_ports {ref_clk_p}] [get_pins {u_frame_buffer_top.u_ddr3_subsystem.I_ips_ddr_top.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {ref_clk_p}] [get_pins {u_frame_buffer_top.u_ddr3_subsystem.I_ips_ddr_top.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {ref_clk_p}] [get_pins {u_frame_buffer_top.u_ddr3_subsystem.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {u_frame_buffer_top.u_ddr3_subsystem.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {u_frame_buffer_top.u_ddr3_subsystem.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {ref_clk_p}] [get_pins {u_frame_buffer_top.u_ddr3_subsystem.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ref_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {u_frame_buffer_top.u_ddr3_subsystem.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {u_frame_buffer_top.u_ddr3_subsystem.I_ips_ddr_top.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_groups -name ref_clk -asynchronous -group [get_clocks {ref_clk}]
set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]
set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]
set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]

# C7 network->DDR and C7 DDR->pixel use Pango DRM asynchronous FIFOs.  Do not
# suppress every path between the source and destination clocks: that would also suppress the Gray
# pointer buses used by the FIFOs' CDC controllers.  The DRM FIFO user guide
# requires each pointer bus to arrive inside one period of its source clock.
#
# C6 network -> DDR FIFO: RGMII and DDR user clocks are both constrained to 125 MHz.
set_max_delay {8.000} -datapath_only -from [get_cells {ethernet_top_Inst_network.u_c6_net_to_ddr_fifo_wrapper.u_c6_net_to_ddr_fifo.U_ipm2l_fifo_c6_net_to_ddr_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.wptr[*]}] -to [get_cells {ethernet_top_Inst_network.u_c6_net_to_ddr_fifo_wrapper.u_c6_net_to_ddr_fifo.U_ipm2l_fifo_c6_net_to_ddr_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.rwptr1[*]}]
set_max_delay {8.000} -datapath_only -from [get_cells {ethernet_top_Inst_network.u_c6_net_to_ddr_fifo_wrapper.u_c6_net_to_ddr_fifo.U_ipm2l_fifo_c6_net_to_ddr_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.rptr[*]}] -to [get_cells {ethernet_top_Inst_network.u_c6_net_to_ddr_fifo_wrapper.u_c6_net_to_ddr_fifo.U_ipm2l_fifo_c6_net_to_ddr_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.wrptr1[*]}]
# DDR -> pixel FIFO: the source-clock periods are reversed.
set_max_delay {8.000} -datapath_only -from [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_fifo.u_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.wptr[*]}] -to [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_fifo.u_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.rwptr1[*]}]
set_false_path -hold -from [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_fifo.u_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.wptr[*]}] -to [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_fifo.u_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.rwptr1[*]}]
set_max_delay {13.468} -datapath_only -from [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_fifo.u_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.rptr[*]}] -to [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_fifo.u_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.wrptr1[*]}]
set_false_path -hold -from [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_fifo.u_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.rptr[*]}] -to [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_fifo.u_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_c5_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.wrptr1[*]}]
set_false_path -to [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_fifo.reg_fifo_rd_rst_meta}]
set_false_path -to [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_fifo.reg_pixel_reset_ack_meta}]
set_false_path -to [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_fifo.reg_measure_enable_meta}]
set_false_path -to [get_cells {u_frame_buffer_top.gen_q8_reader_path.u_display_pipeline.u_underflow_sync.reg_dst_sync0}]
set_false_path -to [get_cells {u_frame_buffer_top.u_c7_slot_grant_sync.reg_toggle_sync0}]
set_false_path -from [get_cells {u_hdmi_board_top.u_source3_abort_diag_sync.reg_event_toggle}] -to [get_cells {u_hdmi_board_top.u_source3_abort_diag_sync.reg_dst_sync0}]

# The remaining C5/C6 domain crossings are deliberately synchronized, one-bit
# control signals.  Exempt only their synchronizer inputs; do not use a
# clock-to-clock false path, because that would also mask the FIFO pointers.
set_false_path -from [get_cells {ethernet_top_Inst_network.u_c6_net_to_ddr_fifo_wrapper.fifo_wr_rst_sync[*]}] -to [get_cells {ethernet_top_Inst_network.u_c6_net_to_ddr_fifo_wrapper.fifo_wr_release_sync[*]}]
set_false_path -from [get_cells {ethernet_top_Inst_network.u_c6_net_to_ddr_fifo_wrapper.fifo_clear_toggle}] -to [get_cells {ethernet_top_Inst_network.u_c6_net_to_ddr_fifo_wrapper.fifo_clear_sync[*]}]
set_false_path -from [get_cells {u_frame_buffer_top.u_c6_abort_event_sync.reg_event_toggle}] -to [get_cells {u_frame_buffer_top.u_c6_abort_event_sync.reg_dst_sync0}]
set_false_path -from [get_cells {u_frame_buffer_top.u_c6_commit_event_sync.reg_event_toggle}] -to [get_cells {u_frame_buffer_top.u_c6_commit_event_sync.reg_dst_sync0}]
# The slot descriptor output is not consumed in the active quad writer; PDS
# removes its two sampling flops. Do not leave false-path rules targeting the
# optimized-away cells. The grant toggle CDC below remains constrained.
set_false_path -from [get_cells {u_frame_buffer_top.u_c7_prepare_event_sync.reg_event_toggle}] -to [get_cells {u_frame_buffer_top.u_c7_prepare_event_sync.reg_dst_sync0}]
set_false_path -from [get_cells {u_frame_buffer_top.u_c7_vblank_event_sync.reg_event_toggle}] -to [get_cells {u_frame_buffer_top.u_c7_vblank_event_sync.reg_dst_sync0}]
# c7_display_valid crosses from DDR to HDMI through a two-flop synchronizer.
# Exempt only the asynchronous input of its first sampling flop; keep the
# first-to-second-flop timing path checked in the HDMI pixel-clock domain.

define_attribute {i:u_frame_buffer_top.u_ddr3_subsystem.I_ips_ddr_top.u_ddrphy_top.u_ddrphy_cpd} {PAP_LOC} {DDRPHY_CPD_369_466}
define_attribute {i:u_frame_buffer_top.u_ddr3_subsystem.I_ips_ddr_top.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate[0]} {PAP_LOC} {CLMA_357_354:FF3}
define_attribute {i:u_frame_buffer_top.u_ddr3_subsystem.I_ips_ddr_top.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate[1]} {PAP_LOC} {CLMA_357_660:FF3}

