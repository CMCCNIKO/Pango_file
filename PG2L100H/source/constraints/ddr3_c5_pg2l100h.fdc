# HSST reset/status is produced from the 27 MHz free-clock controller.  The
# adapter asynchronously deasserts ready and synchronously releases it into
# fiber_rx_clk; only those status-to-synchronizer arcs are asynchronous.
set_false_path -from [get_clocks {sys_clk}] -to [get_cells {u_video_sources_top.u_fiber_hsst_rx_adapter.link_ready_meta u_video_sources_top.u_fiber_hsst_rx_adapter.link_ready_sync}]
