# HDMI monitor CDC; keep original constraints and all same-domain paths.
# All toggle payloads remain stable until confirmation or the next causally
# dependent output frame. Never except whole DDR/pixel/control clock groups.
set_false_path -from [get_cells -hierarchical {*monitor_route_control_Inst_monitor.flag_request_toggle}] -to [get_cells -hierarchical {*monitor_route_control_Inst_monitor.reg_request_sync[*]}]
set_false_path -from [get_cells -hierarchical {*monitor_route_control_Inst_monitor.flag_return_toggle}] -to [get_cells -hierarchical {*monitor_route_control_Inst_monitor.reg_return_sync[*]}]
set_false_path -from [get_cells -hierarchical {*monitor_route_control_Inst_monitor.flag_return_seen}] -to [get_cells -hierarchical {*monitor_route_control_Inst_monitor.reg_return_ack_sync[*]}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {*monitor_route_control_Inst_monitor.reg_request[*]}] -to [get_cells -hierarchical {*monitor_route_control_Inst_monitor.request_route_o[*]}]
set_false_path -hold -from [get_cells -hierarchical {*monitor_route_control_Inst_monitor.reg_request[*]}] -to [get_cells -hierarchical {*monitor_route_control_Inst_monitor.request_route_o[*]}]
# ACK数组寄存器位于monitor_route_control的gen_ack_ff[0..7]命名generate内。
# 保持原8ns邮箱载荷预算，仅修正真实综合层级；不豁免其他DDR/control路径。
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {*monitor_route_control_Inst_monitor.reg_return[*]}] -to [get_cells -hierarchical {*monitor_route_control_Inst_monitor.reg_active[*] *monitor_route_control_Inst_monitor.gen_ack_ff*.reg_queue*}]
set_false_path -hold -from [get_cells -hierarchical {*monitor_route_control_Inst_monitor.reg_return[*]}] -to [get_cells -hierarchical {*monitor_route_control_Inst_monitor.reg_active[*] *monitor_route_control_Inst_monitor.gen_ack_ff*.reg_queue*}]

set_false_path -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.frame_toggle}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.frame_sync[*]}]
set_false_path -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.prepared_toggle}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.prepared_sync[*]}]
set_false_path -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.applied_toggle}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.applied_sync[*]}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.pixel_frame_id[*]}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.descriptor_frame_id[*]}]
set_false_path -hold -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.pixel_frame_id[*]}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.descriptor_frame_id[*]}]
set_max_delay 13.468 -datapath_only -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.prepared_hold[*] *monitor_display_pipeline_Inst_monitor.prepared_frame_hold[*]}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.pixel_prepared_route[*] *monitor_display_pipeline_Inst_monitor.pixel_prepared_frame[*]}]
set_false_path -hold -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.prepared_hold[*] *monitor_display_pipeline_Inst_monitor.prepared_frame_hold[*]}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.pixel_prepared_route[*] *monitor_display_pipeline_Inst_monitor.pixel_prepared_frame[*]}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.applied_hold[*]}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.active_route_ddr[*] *monitor_display_pipeline_Inst_monitor.active_route_o[*] *monitor_display_pipeline_Inst_monitor.active_valid_o *monitor_display_pipeline_Inst_monitor.pending_valid}]
set_false_path -hold -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.applied_hold[*]}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.active_route_ddr[*] *monitor_display_pipeline_Inst_monitor.active_route_o[*] *monitor_display_pipeline_Inst_monitor.active_valid_o *monitor_display_pipeline_Inst_monitor.pending_valid}]

# Only first-stage CDC samplers; second-stage transitions remain normally timed.
set_false_path -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.u_fifo.reg_fifo_rd_rst_meta *monitor_display_pipeline_Inst_monitor.u_fifo.reg_pixel_reset_ack_meta *monitor_display_pipeline_Inst_monitor.u_fifo.reg_measure_enable_meta}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.u_fifo.u_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.wptr[*]}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.u_fifo.u_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.rwptr1[*]}]
set_false_path -hold -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.u_fifo.u_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.wptr[*]}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.u_fifo.u_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.rwptr1[*]}]
set_max_delay 13.468 -datapath_only -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.u_fifo.u_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.rptr[*]}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.u_fifo.u_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.wrptr1[*]}]
set_false_path -hold -from [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.u_fifo.u_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.rptr[*]}] -to [get_cells -hierarchical {*monitor_display_pipeline_Inst_monitor.u_fifo.u_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_monitor_ddr_to_hdmi_fifo.U_ipm2l_fifo_ctrl.ASYN_CTRL.wrptr1[*]}]
set_false_path -to [get_pins -hierarchical {*u_avm_monitor_top.monitor_control_ddr_reset_sync*.C}]
