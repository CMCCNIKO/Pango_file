# T04 video CDC constraints for the actual board hierarchy.
# Existing HDMI/PCIe clocks are declared in the other FDCs; no harness I/O budgets.
# Bound Gray/source-to-first-stage data; retain second-stage and normal logic timing.
# Integrated placement/routing and board I/O closure remain a T06 gate.
set_max_delay 13.468 -datapath_only -from [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.u_ASYN_FIFO.U_ipm2l_fifo_ASYN_FIFO.U_ipm2l_fifo_ctrl.ASYN_CTRL.wptr*}] -to [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.u_ASYN_FIFO.U_ipm2l_fifo_ASYN_FIFO.U_ipm2l_fifo_ctrl.ASYN_CTRL.rwptr1*}]
set_false_path -hold -from [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.u_ASYN_FIFO.U_ipm2l_fifo_ASYN_FIFO.U_ipm2l_fifo_ctrl.ASYN_CTRL.wptr*}] -to [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.u_ASYN_FIFO.U_ipm2l_fifo_ASYN_FIFO.U_ipm2l_fifo_ctrl.ASYN_CTRL.rwptr1*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.u_ASYN_FIFO.U_ipm2l_fifo_ASYN_FIFO.U_ipm2l_fifo_ctrl.ASYN_CTRL.rptr*}] -to [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.u_ASYN_FIFO.U_ipm2l_fifo_ASYN_FIFO.U_ipm2l_fifo_ctrl.ASYN_CTRL.wrptr1*}]
set_false_path -hold -from [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.u_ASYN_FIFO.U_ipm2l_fifo_ASYN_FIFO.U_ipm2l_fifo_ctrl.ASYN_CTRL.rptr*}] -to [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.u_ASYN_FIFO.U_ipm2l_fifo_ASYN_FIFO.U_ipm2l_fifo_ctrl.ASYN_CTRL.wrptr1*}]
set_max_delay 8.000 -datapath_only -from [get_clocks {pcie_pclk_div2}] -to [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.grant_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.grant_epoch_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.flush_sync_hdmi* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.rate_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.wr_flush_req_sync*}]
set_false_path -hold -from [get_clocks {pcie_pclk_div2}] -to [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.grant_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.grant_epoch_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.flush_sync_hdmi* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.rate_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.wr_flush_req_sync*}]
set_max_delay 8.000 -datapath_only -from [get_clocks {hdmi_pixel_clk}] -to [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.ctrl_flush_ack_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.tap_flush_ack_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.wr_done_sync*}]
set_false_path -hold -from [get_clocks {hdmi_pixel_clk}] -to [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.ctrl_flush_ack_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.tap_flush_ack_sync* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.wr_done_sync*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_frame_id* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_byte_count* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_word_count* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_crc32* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_drop* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_error*}] -to [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_frame_id_o* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_byte_count_o* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_word_count_o* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_crc32_o* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_drop_o* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_error_o*}]
set_false_path -hold -from [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_frame_id* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_byte_count* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_word_count* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_crc32* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_drop* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.hdmi_meta_error*}] -to [get_cells -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_frame_id_o* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_byte_count_o* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_word_count_o* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_crc32_o* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_drop_o* u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_ctrl.meta_error_o*}]
set_false_path -to [get_pins -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.wr_local_reset_sync*.C u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.u_fifo.rd_local_reset_sync*.C}]
# Joint asynchronous reset is accepted only at the reset-release chain inputs.
set_false_path -to [get_pins -hierarchical {u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.pixel_reset_sync*.C u_pcie_top.u_pcie_dma_subsystem.u_video.u_capture.pcie_reset_sync*.C}]
