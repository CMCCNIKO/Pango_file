define_attribute {i:u_pcie_top.u_pcie_dma_subsystem.u_pcie_ip.U_IPS2L_PCIE_TOP.U_IPS2L_PCIE_HARD_CTRL.pcie2_iip_exrcvhdr_rams.U_ipm2l_sdpram_rcv_header_ram.ADDR_LOOP[0].DATA_LOOP[0].U_GTP_DRM18K_E1} {PAP_LOC} {DRM_298_888:DRM0}
define_attribute {i:u_pcie_top.u_pcie_dma_subsystem.u_pcie_ip.U_IPS2L_PCIE_TOP.U_IPS2L_PCIE_HARD_CTRL.pcie2_iip_exrcvhdr_rams.U_ipm2l_sdpram_rcv_header_ram.ADDR_LOOP[0].DATA_LOOP[1].U_GTP_DRM18K_E1} {PAP_LOC} {DRM_298_948:DRM0}
