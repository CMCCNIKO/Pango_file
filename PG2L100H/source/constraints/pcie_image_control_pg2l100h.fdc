# PCIe image-control session: two transaction mailboxes, 125 MHz on both sides.
# The asynchronous clocks are not grouped. Only toggle launch -> synchronizer
# input and stable, handshaken payload pairs receive exceptions. The second
# synchronizer stage and all synchronous CSR/arbitration paths remain timed.
# PDS imports vector registers as aggregate cells before splitting: a path from
# flag_request/ack exists only to bit0, never the bit0->bit1 synchronous path.
set_false_path -from [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.flag_request *u_image_control_bridge.u_algo_mailbox.flag_request}] -to [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.reg_request_sync[*] *u_image_control_bridge.u_algo_mailbox.reg_request_sync[*]}]
set_false_path -from [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.flag_ack *u_image_control_bridge.u_algo_mailbox.flag_ack}] -to [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.reg_ack_sync[*] *u_image_control_bridge.u_algo_mailbox.reg_ack_sync[*]}]

# Source request/config freezes before the request toggle passes two stages.
# Destination captures only after observing the synchronized toggle. Each pair
# is bounded to one receiving period; only its asynchronous hold is waived.
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.reg_request_config[*] *u_image_control_bridge.u_isp_mailbox.reg_request_query}] -to [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.dst_config_o[*] *u_image_control_bridge.u_isp_mailbox.dst_query_o}]
set_false_path -hold -from [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.reg_request_config[*] *u_image_control_bridge.u_isp_mailbox.reg_request_query}] -to [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.dst_config_o[*] *u_image_control_bridge.u_isp_mailbox.dst_query_o}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {*u_image_control_bridge.u_algo_mailbox.reg_request_config[*] *u_image_control_bridge.u_algo_mailbox.reg_request_query}] -to [get_cells -hierarchical {*u_image_control_bridge.u_algo_mailbox.dst_config_o[*] *u_image_control_bridge.u_algo_mailbox.dst_query_o}]
set_false_path -hold -from [get_cells -hierarchical {*u_image_control_bridge.u_algo_mailbox.reg_request_config[*] *u_image_control_bridge.u_algo_mailbox.reg_request_query}] -to [get_cells -hierarchical {*u_image_control_bridge.u_algo_mailbox.dst_config_o[*] *u_image_control_bridge.u_algo_mailbox.dst_query_o}]

# Response payload and ACK launch together and remain stable until the next
# destination completion, which requires another round-trip request handshake.
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.reg_response_*}] -to [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.src_snapshot_o[*] *u_image_control_bridge.u_isp_mailbox.src_epoch_o[*] *u_image_control_bridge.u_isp_mailbox.src_source_o[*] *u_image_control_bridge.u_isp_mailbox.src_status_o[*]}]
set_false_path -hold -from [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.reg_response_*}] -to [get_cells -hierarchical {*u_image_control_bridge.u_isp_mailbox.src_snapshot_o[*] *u_image_control_bridge.u_isp_mailbox.src_epoch_o[*] *u_image_control_bridge.u_isp_mailbox.src_source_o[*] *u_image_control_bridge.u_isp_mailbox.src_status_o[*]}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {*u_image_control_bridge.u_algo_mailbox.reg_response_*}] -to [get_cells -hierarchical {*u_image_control_bridge.u_algo_mailbox.src_snapshot_o[*] *u_image_control_bridge.u_algo_mailbox.src_epoch_o[*] *u_image_control_bridge.u_algo_mailbox.src_source_o[*] *u_image_control_bridge.u_algo_mailbox.src_status_o[*]}]
set_false_path -hold -from [get_cells -hierarchical {*u_image_control_bridge.u_algo_mailbox.reg_response_*}] -to [get_cells -hierarchical {*u_image_control_bridge.u_algo_mailbox.src_snapshot_o[*] *u_image_control_bridge.u_algo_mailbox.src_epoch_o[*] *u_image_control_bridge.u_algo_mailbox.src_source_o[*] *u_image_control_bridge.u_algo_mailbox.src_status_o[*]}]

# Combined session reset asserts asynchronously; only the local release chains'
# clear pins are excepted. Their stage-to-stage D paths are not excepted.
set_false_path -to [get_pins -hierarchical {*u_image_control_bridge.reg_pcie_reset_sync*.C *u_image_control_bridge.reg_control_reset_sync*.C}]
